# Copy to .env.local for local development. On Render, render.yaml wires the database, Key
# Value and SESSION_SECRET for you; the rest are entered in the dashboard.

# Postgres (Render Postgres in production; `npx prisma dev` or any local Postgres for development)
DATABASE_URL=
# Render Key Value or any Redis/Valkey, for session audio and photos (held at most 1 hour)
REDIS_URL=redis://localhost:6380
# Signs the sign-in cookie and quiz links. At least 32 random characters.
SESSION_SECRET=

# PayPal sandbox REST app, from developer.paypal.com. Enable partial captures (and Payouts) on
# the sandbox business account.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# The same client ID, exposed to the browser for the PayPal checkout button.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Claude (topics, quizzes, grading, dashboard assistant) and OpenAI (speech-to-text).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Background jobs. "inline" runs workflow tasks inside this process (local development).
# Leave it unset on Render, where jobs start Render Workflow tasks with RENDER_API_KEY.
WORKFLOW_MODE=inline
RENDER_API_KEY=
RENDER_WORKFLOW_SLUG=gained-workflow

# Optional: AG Studio licence key for the tutor dashboard (/tutor). The dashboard's AI assistant
# needs it (Pro with AI) plus ANTHROPIC_API_KEY; without either, the assistant is hidden.
AG_STUDIO=

# The admin resolves grade appeals. `npm run create-admin` creates the account (no demo data);
# `npm run seed` also creates it. Use an email that isn't already a family or tutor account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: a sandbox personal account email, to test tutor Payouts in npm run money-loop.
TUTOR_PAYPAL_EMAIL=
